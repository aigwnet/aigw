[Unit]
Description=AI Gateway Console
After=network.target
PartOf=aigwc.target
Documentation=man:aigwc(1)

[Service]
Type=forking
ExecStart=/usr/bin/aigwc --config /etc/aigw/aigwc.toml --ui /etc/aigw/ui/ --daemon --log-dir /var/log/aigwc/ --pid-file /run/aigwc.pid
PIDFile=/run/aigwc.pid
WorkingDirectory=/etc/aigw
RestartSec=5s
Restart=on-failure
TasksMax=64
MemoryMax=1024M
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log /run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETGID CAP_SETUID CAP_SYS_CHROOT
DeviceAllow=/dev/null rw
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target